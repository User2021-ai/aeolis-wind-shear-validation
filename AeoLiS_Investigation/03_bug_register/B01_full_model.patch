+def scalar_fft_roughness(z0, grid_shape):
+    """Return scalar roughness for the spatially uniform FFT formulation.
+
+    Exactly uniform fields are equivalent to a scalar. Spatial variation is
+    unsupported; never silently average it or pair spatial cells with modes.
+    """
+    values = np.asarray(z0)
+    if values.dtype.kind not in 'iuf':
+        raise ValueError('FFT roughness must contain real numeric values in metres.')
+    if values.ndim != 0 and values.shape != tuple(grid_shape):
+        raise ValueError('FFT roughness array must match the terrain grid shape.')
+    if values.size == 0 or not np.all(np.isfinite(values)) or np.any(values <= 0):
+        raise ValueError('FFT roughness must be finite and strictly positive.')
+    first = values.flat[0]
+    if not np.all(values == first):
+        raise NotImplementedError(
+            'Spatially varying roughness is unsupported by the FFT shear method. '
+            'Use scalar or exactly uniform roughness; no averaging is applied.'
+        )
+    return float(first)
+
